[Unit]
Description=AgentFlow backend API (0.0.0.0:8000)
After=network.target agentflow-mysql.service
Requires=agentflow-mysql.service

[Service]
Type=simple
WorkingDirectory=@REPO@/backend
EnvironmentFile=@DATA@/agentflow.env
ExecStart=@DATA@/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
TimeoutStartSec=90

[Install]
WantedBy=default.target
